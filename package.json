{
  "name": "wiggle-note",
  "productName": "WiggleNote",
  "private": true,
  "version": "0.0.9",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "electron .",
    "release": "standard-version"
  },
  "build": {
    "appId": "com.wigglenote.app",
