    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^41.7.1",
    "electron-rebuild": "^3.2.9",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.6.0",
    "standard-version": "^9.5.0",
    "vite": "^8.0.12"
