    "@tiptap/pm": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "axios": "^1.18.1",
    "better-auth": "^1.7.7",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.21.0",
    "marked": "^18.0.5",
    "radix-ui": "^1.6.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.0",
    "shadcn": "^4.21.3",
    "tailwindcss": "^4.3.3",
    "turndown": "^7.2.4",
    "tw-animate-css": "^1.4.0"
